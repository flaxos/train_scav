+func _reverse_trailing_move_uses_traversed_branch_not_current_switch_route() -> void:
+	var sim = RailMovement.new()
+	sim.active_units = _typed_units(["L", "A", "B"])
+	var detached_consists: Array[Dictionary] = []
+	sim.detached_consists = detached_consists
+	sim.current_segment = RailMovement.SEGMENT_MAIN_EAST
+	sim.distance = 1.0
+	sim.direction = -1
+	sim.speed = 8.0
+	sim.throttle = 1.0
+	sim.max_speed = 8.0
+	sim.acceleration = 0.0
+	sim.coast_deceleration = 0.0
+
+	# P1 is deliberately set toward SIDING for a future facing move. A train
+	# already reversing from MAIN_EAST must still keep its trailing bodies on
+	# MAIN_EAST while it clears the turnout; it must not visually jump to SIDING.
+	sim.set_points_route(RailMovement.POINTS_SIDING)
+	sim.step(0.25, false)
+
+	_expect(sim.current_segment == RailMovement.SEGMENT_MAIN_WEST, "reverse trailing move enters the common P1 leg")
+	var states := _active_states(sim.get_unit_draw_states())
+	var occupied_segments := _state_segments(states)
+	_expect(occupied_segments.has(RailMovement.SEGMENT_MAIN_EAST), "straddling consist keeps trailing bodies on the segment it actually came from")
+	_expect(not occupied_segments.has(RailMovement.SEGMENT_SIDING), "reverse trailing move does not jump onto P1's currently selected facing branch")
+
+
